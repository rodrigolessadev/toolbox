{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbox",
  "version": "1.33.0",
  "identifier": "com.toolbox.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toolbox",
        "width": 920,
        "height": 620,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "resources": [
      "resources/runtime/**/*"
    ],
    "shortDescription": "Toolbox com Plugins",
    "longDescription": "Aplicativo desktop moderno e leve para executar comandos, links e aplicativos via plugins personalizados.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libappindicator3-1"
        ],
        "section": "utils"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzNzVCQjI0OTM4QTkyNjEKUldSaGtvcVRKTHQxUTFmZkVrRVpITnFtZU1lWUVCQmJ0RFJjcGZrcE1ndkN2UUFaVW4xM00rU2gK",
      "endpoints": [
        "https://github.com/rodrigolessadev/toolbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
