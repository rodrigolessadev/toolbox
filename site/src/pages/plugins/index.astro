---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const pluginsList = await getCollection('plugins');
const sortedPlugins = pluginsList.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<Base 
  title="Catálogo de Plugins — Toolbox" 
  description="Explore plugins utilitários, integradores e orquestradores de análise para o Toolbox Desktop."
>
  <div class="plugins-hero">
    <div class="hero-badge">📦 Ecossistema de Plugins</div>
    <h1>Catálogo de Plugins Oficiais</h1>
    <p class="hero-desc">
      Turbine o seu Toolbox Desktop com plugins utilitários, geradores de dados, conversores e suítes completas de análise de incidentes.
    </p>
  </div>

  <div class="search-bar-wrap">
    <input 
      type="text" 
      id="pluginSearch" 
      placeholder="Pesquisar plugins por nome, tag ou funcionalidade..." 
      class="search-input"
    />
  </div>

  <div class="plugins-grid" id="pluginsGrid">
    {sortedPlugins.map((plugin) => (
      <a href={`/plugins/${plugin.data.id}`} class="plugin-card" data-tags={plugin.data.tags.join(' ')} data-name={plugin.data.name.toLowerCase()} data-desc={plugin.data.description.toLowerCase()}>
        <div class="card-header">
          <div class="plugin-icon-box">⚡</div>
          <div class="plugin-title-box">
            <h2 class="plugin-name">{plugin.data.name}</h2>
            <span class="plugin-version">v{plugin.data.version}</span>
          </div>
        </div>
        
        <p class="plugin-desc">{plugin.data.description}</p>

        <div class="card-footer">
          <div class="plugin-tags">
            {plugin.data.tags.slice(0, 3).map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
          <span class="btn-detail">Ver Documentação →</span>
        </div>
      </a>
    ))}
  </div>
</Base>

<script>
  const searchInput = document.getElementById('pluginSearch') as HTMLInputElement;
  const cards = document.querySelectorAll('.plugin-card') as NodeListOf<HTMLElement>;

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = (e.target as HTMLInputElement).value.toLowerCase().trim();
      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const desc = card.getAttribute('data-desc') || '';
        const tags = card.getAttribute('data-tags') || '';
        if (name.includes(q) || desc.includes(q) || tags.toLowerCase().includes(q)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  }
</script>

<style>
  .plugins-hero {
    text-align: center;
    padding: 32px 0 20px;
    max-width: 720px;
    margin: 0 auto;
  }
  .hero-badge {
    display: inline-block;
    padding: 4px 12px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .plugins-hero h1 {
    font-size: 2.4rem;
    font-weight: 800;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }
  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .search-bar-wrap {
    max-width: 640px;
    margin: 24px auto 36px;
  }
  .search-input {
    width: 100%;
    padding: 12px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .search-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
  }
  .plugins-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 60px;
  }
  .plugin-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .plugin-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }
  .plugin-icon-box {
    width: 38px;
    height: 38px;
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    color: var(--accent);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    font-size: 1.2rem;
  }
  .plugin-title-box {
    display: flex;
    flex-direction: column;
  }
  .plugin-name {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 0;
    color: var(--text);
  }
  .plugin-version {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }
  .plugin-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
    flex-grow: 1;
    margin: 0 0 16px;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }
  .plugin-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag {
    font-size: 0.75rem;
    background: var(--bg);
    border: 1px solid var(--border);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--text-muted);
  }
  .btn-detail {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
